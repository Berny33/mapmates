# Port where the HTTP server listens.
PORT=

# Execution mode: development, test or production.
NODE_ENV=

# PostgreSQL connection URL of the application database: protocol, user, password, host, port and database name.
DATABASE_URL=

# PostgreSQL connection URL of the test database. The database name must end with _test.
TEST_DATABASE_URL=

# Secret that signs the session cookie: a long random text, different in every environment.
SESSION_SECRET=

# Password hashing cost (bcrypt rounds). Optional: a secure default is used when empty.
BCRYPT_ROUNDS=

# Maximum login and registration attempts per client every 15 minutes. Optional: a default is used when empty.
AUTH_RATE_LIMIT=

# Identification sent to the geocoding service (Nominatim): application name and a contact. Used from Sprint 3.
GEOCODING_USER_AGENT=